# Claude API key (server-side only)
NUXT_ANTHROPIC_API_KEY=sk-ant-...
# Optional model override
# NUXT_ANTHROPIC_MODEL=claude-sonnet-5-5

# Parents allowed to skip problems: comma-separated email:password pairs
# (a password may contain ":" but not ",")
NUXT_PARENTS=mama@example.com:change-me,papa@example.com:change-me-too

# Encrypts the parent session cookie, at least 32 characters
NUXT_SESSION_PASSWORD=
# Set to true only when the app is served over HTTPS (docker compose sets it, Caddy provides HTTPS)
# NUXT_SESSION_COOKIE_SECURE=true

# Docker: the Pi's fixed LAN IP that tablets open over HTTPS (see Caddyfile)
SITE_ADDRESS=192.168.88.213
# Ports Caddy listens on (defaults); 80/443 are not used
# HTTPS_PORT=3000
# HTTP_PORT=3080

# SQLite file location
NUXT_DB_PATH=./data/math.sqlite
